POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

APP_PORT=5000

# Wildberries API token (Prices and Discounts / Tariffs scope)
WBTOKEN=

# Path inside the container; the host file ./google-credentials.json is mounted there by compose
GOOGLE_CREDENTIALS_PATH=/app/google-credentials.json

# Comma-separated Google Spreadsheet IDs; more can be inserted into the `spreadsheets` table
SPREADSHEET_IDS=
