# Copy to .env and fill in the required values. Lines marked (required) have no default.

# --- PostgreSQL ---------------------------------------------------------------
# docker compose overrides POSTGRES_HOST with the `postgres` service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
# (required)
POSTGRES_PASSWORD=postgres

# --- Wildberries API ----------------------------------------------------------
# (required) API token with access to the Tariffs category
WBTOKEN=
# Override for mocks/tests
WB_API_BASE_URL=https://common-api.wildberries.ru
WB_REQUEST_TIMEOUT_MS=30000
# Total attempts per request (retries on network errors, 5xx and 429)
WB_RETRY_ATTEMPTS=3

# --- Google Sheets ------------------------------------------------------------
# (required) Path to the service-account JSON key. Inside docker compose the host file
# ./google-credentials.json is mounted read-only at /app/google-credentials.json.
GOOGLE_CREDENTIALS_PATH=/app/google-credentials.json
# Comma-separated spreadsheet IDs; merged with rows of the `spreadsheets` table
SPREADSHEET_IDS=
SHEETS_SHEET_NAME=stocks_coefs
# latest = rows of the most recent date only; all = full history
SHEETS_PUBLISH_SCOPE=latest

# --- Scheduler ----------------------------------------------------------------
# Pipeline cadence in milliseconds (default: 1 hour)
SYNC_INTERVAL_MS=3600000
# Run a cycle immediately at boot (true|false)
RUN_ON_START=true
# Consecutive failures of a step before its circuit breaker opens
CIRCUIT_BREAKER_THRESHOLD=5
# How long an open breaker waits before allowing one probe attempt (default: 1 hour)
CIRCUIT_BREAKER_RESET_MS=3600000

# --- Runtime ------------------------------------------------------------------
# Port for /healthz, /readyz and /status
APP_PORT=5000
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# development|production|test
NODE_ENV=development

# --- Tests --------------------------------------------------------------------
# Only needed for `npm run test:integration`, e.g. postgres://postgres:postgres@localhost:5432/postgres
# TEST_DATABASE_URL=
