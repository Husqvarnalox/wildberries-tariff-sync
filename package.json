{
    "name": "wildberries-tariff-sync",
    "version": "0.1.0",
    "description": "Synchronizes Wildberries warehouse box tariffs into PostgreSQL and publishes them to Google Sheets",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "nodemon --watch src --ext ts --exec tsx src/app.ts",
        "build": "tsc --allowJs",
        "start": "node dist/app.js",
        "knex": "node dist/utils/knex.js",
        "knex:dev": "tsx src/utils/knex.ts",
        "typecheck": "tsc --allowJs --noEmit",
        "test": "tsx --test src/**/*.test.ts",
        "format:check": "prettier --config .prettierrc.json \"src/**/*.{ts,js}\" --check"
    },
    "imports": {
        "#*": [
            "./dist/*",
            "./src/*"
        ]
    },
    "license": "Apache-2.0",
    "dependencies": {
        "commander": "^13.1.0",
        "dotenv": "^16.3.1",
        "googleapis": "^144.0.0",
        "knex": "^3.0.1",
        "pg": "^8.11.3",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.17.0",
        "@types/pg": "^8.11.10",
        "nodemon": "^3.0.2",
        "prettier": "^3.3.3",
        "prettier-plugin-jsdoc": "^1.3.0",
        "tsx": "^4.7.1",
        "typescript": "^5.7.3"
    }
}
