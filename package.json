{
    "name": "wildberries-tariff-sync",
    "version": "0.2.0",
    "description": "Synchronizes Wildberries warehouse box tariffs into PostgreSQL and publishes them to Google Sheets",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/app.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node scripts/run-tests.mjs unit",
        "test:integration": "node scripts/run-tests.mjs integration",
        "test:all": "npm test && npm run test:integration",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "knex": "node dist/cli/knex.js",
        "knex:dev": "tsx src/cli/knex.ts"
    },
    "imports": {
        "#*": [
            "./dist/*",
            "./src/*"
        ]
    },
    "license": "Apache-2.0",
    "dependencies": {
        "commander": "^15.0.0",
        "dotenv": "^16.3.1",
        "googleapis": "^185.0.0",
        "knex": "^3.0.1",
        "pg": "^8.11.3",
        "pino": "^9.5.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.0",
        "@types/pg": "^8.11.10",
        "eslint": "^9.17.0",
        "globals": "^15.14.0",
        "pino-pretty": "^13.0.0",
        "prettier": "^3.3.3",
        "prettier-plugin-jsdoc": "^1.3.0",
        "tsx": "^4.7.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.18.0"
    }
}
