{
    "plugins": ["prettier-plugin-jsdoc"],
    "tabWidth": 4,
    "printWidth": 160,
    "singleQuote": false,
    "trailingComma": "all",
    "singleAttributePerLine": false,
    "quoteProps": "preserve",
    "bracketSpacing": true,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
